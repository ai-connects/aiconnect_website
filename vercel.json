{
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/blog",
      "destination": "https://www.aihavit.com/blog",
      "permanent": true
    },
    {
      "source": "/blog/:path*",
      "destination": "https://www.aihavit.com/blog",
      "permanent": true
    },
    {
      "source": "/privacy-policy",
      "destination": "https://www.aihavit.com/privacy.html",
      "permanent": true
    },
    {
      "source": "/terms-of-service",
      "destination": "https://www.aihavit.com/terms.html",
      "permanent": true
    },
    {
      "source": "/",
      "destination": "https://www.aihavit.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "destination": "https://www.aihavit.com/",
      "permanent": true
    }
  ]
}
